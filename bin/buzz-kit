#!/bin/sh
# M0 development launcher. Release download/verification is implemented in M2.
set -eu
die() { printf 'buzz-kit: %s\n' "$*" >&2; exit 1; }
SELF=$0
case "$SELF" in /*) ;; *) SELF="$PWD/$SELF" ;; esac
LINK_COUNT=0
while [ -L "$SELF" ]; do
    LINK_COUNT=$((LINK_COUNT + 1))
    [ "$LINK_COUNT" -le 40 ] || die 'launcher symlink loop'
    LINK=$(readlink "$SELF")
    case "$LINK" in /*) SELF=$LINK ;; *) SELF="$(dirname -- "$SELF")/$LINK" ;; esac
done
KIT_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd -P)
: "${HOME:?HOME must be set}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/buzz-kit"
SHIM="$HOME/.local/bin/buzz-kit"
MARKER='# buzz-kit managed shim'

bootstrap() {
    [ -n "${BUZZ_KIT_BIN:-}" ] || die "M0 requires BUZZ_KIT_BIN=$KIT_DIR/scripts/m0-dev-binary; no release binary exists yet"
    case "$BUZZ_KIT_BIN" in /*) ;; *) die 'BUZZ_KIT_BIN must be an absolute path' ;; esac
    [ -f "$BUZZ_KIT_BIN" ] && [ -x "$BUZZ_KIT_BIN" ] || die 'development binary is not executable'
    if [ -e "$SHIM" ] || [ -L "$SHIM" ]; then
        [ -f "$SHIM" ] && [ ! -L "$SHIM" ] &&
            [ "$(sed -n '2p' "$SHIM")" = "$MARKER" ] || die "refusing foreign shim: $SHIM"
    fi
    # This stub cache is deliberately separate from future immutable bin-v* entries.
    CACHE="$DATA_DIR/bin/dev-m0"
    if [ -e "$CACHE" ]; then
        cmp -s "$BUZZ_KIT_BIN" "$CACHE/buzz-kit" || die 'M0 development cache differs; use a fresh test HOME'
    fi
    mkdir -p "$DATA_DIR/bin" "$HOME/.local/bin"
    STAGING=$(mktemp -d "$DATA_DIR/.bootstrap.XXXXXX")
    SHIM_TMP=$(mktemp "$HOME/.local/bin/.buzz-kit.XXXXXX")
    trap 'rm -rf "$STAGING"; rm -f "$SHIM_TMP"' EXIT HUP INT TERM
    if [ ! -e "$CACHE" ]; then
        mkdir "$STAGING/binary"
        cp "$BUZZ_KIT_BIN" "$STAGING/binary/buzz-kit"
        chmod 755 "$STAGING/binary/buzz-kit"
        mv "$STAGING/binary" "$CACHE"
    fi
    # Quote a literal path for the 3-line POSIX shim, including apostrophes.
    QUOTED=$(printf '%s' "$DATA_DIR/current/buzz-kit" | sed "s/'/'\\\\''/g")
    printf '#!/bin/sh\n%s\nexec '\''%s'\'' "$@"\n' "$MARKER" "$QUOTED" > "$SHIM_TMP"
    chmod 755 "$SHIM_TMP"
    ln -s 'bin/dev-m0' "$STAGING/current"
    case "$(uname -s)" in
        Darwin) mv -fh "$STAGING/current" "$DATA_DIR/current" ;;
        Linux) mv -fT "$STAGING/current" "$DATA_DIR/current" ;;
        *) die 'M0 supports macOS and Linux only' ;;
    esac
    mv -f "$SHIM_TMP" "$SHIM"
    printf 'M0 development bootstrap (no release verification): %s\n' "$SHIM"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) printf 'Shim directory is on PATH.\n' ;;
        *) printf 'Next steps: add to your shell, then start a fresh session:\nexport PATH="$HOME/.local/bin:$PATH"\n' ;;
    esac
}

if [ "${1:-}" = bootstrap ]; then
    [ "$#" -eq 1 ] || die 'usage: buzz-kit bootstrap'
    bootstrap
    exit 0
fi
if [ -n "${BUZZ_KIT_BIN:-}" ]; then
    case "$BUZZ_KIT_BIN" in /*) ;; *) die 'BUZZ_KIT_BIN must be an absolute path' ;; esac
    exec "$BUZZ_KIT_BIN" "$@"
fi
[ -x "$DATA_DIR/current/buzz-kit" ] || die 'M0 has no current binary; run explicit-path bootstrap with BUZZ_KIT_BIN'
exec "$DATA_DIR/current/buzz-kit" "$@"
